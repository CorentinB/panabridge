{
  "pluginAlias": "PanaBridge",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "BluRay Player"
      },
      "host": {
        "title": "IP Address",
        "type": "string",
        "required": true
      },
      "pollInterval": {
        "title": "Polling Interval (ms)",
        "type": "number",
        "required": false,
        "default": 500
      },
      "debug": {
        "title": "Enable Debug Logging",
        "type": "boolean",
        "required": false,
        "default": false
      }
    }
  }
}